# Copy to sam.env (same directory) and fill in. Every example loads it first.
# Keep sam.env private: it holds an API key secret.

# Where SAM lives. There is no default, so a shared copy never refreshes a
# production cache by accident.
export SAM_API_BASE=https://samuel.k8s.ucar.edu
# export SAM_API_BASE=https://samuel-dev.k8s.ucar.edu
# export SAM_API_BASE=http://localhost:5050

# Your API key: its name and its secret (HTTP Basic auth).
export SAM_API_USER=
export SAM_API_PASS=

# Optional: separate keys for the two role-gated families. Each falls back to
# SAM_API_USER / SAM_API_PASS.
# export SAM_LDAPSYNC_USER=
# export SAM_LDAPSYNC_PASS=
# export SAM_XRAS_USER=
# export SAM_XRAS_PASS=

# Optional: which project and user the examples look up. By default they pick
# the first active project and its lead.
# export SAM_DEMO_PROJCODE=
# export SAM_DEMO_USERNAME=
