From 60c555a751e60ef282ada7faacaf93a2bace9740 Mon Sep 17 00:00:00 2001
From: Benjamin Kirk <benkirk@ucar.edu>
Date: Fri, 9 Oct 2026 09:01:51 -0600
Subject: [PATCH 3/4] Skip a modify for an unknown key instead of rebuilding
 from SAM

A modify whose record is in neither SAM nor the add file threw
IMDBStateException; the rebuild could not supply the record, so every
collection was downloaded again every 300 s. Log it and skip the modify;
the next add file brings the record in.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01EgPyNLobhxFie7ZK1MJxqX
---
 lib/IDMSPerson.t         | 8 +++++++-
 lib/IDMSUpdateManager.pm | 4 ++--
 2 files changed, 9 insertions(+), 3 deletions(-)

diff --git a/lib/IDMSPerson.t b/lib/IDMSPerson.t
index 4df0439..78f74a3 100755
--- a/lib/IDMSPerson.t
+++ b/lib/IDMSPerson.t
@@ -15,7 +15,7 @@ use IDMSUpdate;
 
 use TestData;
 
-use Test::Most tests => 39;
+use Test::Most tests => 41;
 
 require_ok('IDMSPerson');
 require_ok('IDMSCollaboration');
@@ -272,3 +272,9 @@ $userData = SamUpdate::data($posUpdate);
 is_deeply($userData,$samUserTestData,
           'SamUpdate from staff 2 new ID applyUpdate()s has expected data rec');
 
+my $unknownMod = IDMSUpdate->new('modify',['person','999999999'],
+                                 $idmsPersonModRec->{'data'});
+lives_ok { ($updType,$samDataMgr,$oldRec,$newRec) =
+               $personMgr->applyUpdate($unknownMod) }
+   'modify for an unknown person does not throw';
+ok(!defined($newRec), 'modify for an unknown person is skipped');
diff --git a/lib/IDMSUpdateManager.pm b/lib/IDMSUpdateManager.pm
index 6324bae..32d0f3b 100644
--- a/lib/IDMSUpdateManager.pm
+++ b/lib/IDMSUpdateManager.pm
@@ -368,10 +368,10 @@ sub _applyAddOrModify {
 
     } elsif ($updType eq "modify") {
         if (! defined($samRec)) {
-            my $msg = sprintf("Update to unknown SAM object: idmsUpdate=%s\n",
+            my $msg = sprintf("Update to unknown SAM object, skipped: idmsUpdate=%s\n",
                     Dumper($idmsUpdate));
             vprintf(ERROR,$msg);
-            throwIMDBStateException($msg);
+            return ($updType,undef);
         }
         ($updType,$newSamRec) = $self->modifySamData($idmsUpdate, $samRec);
     } else {
-- 
