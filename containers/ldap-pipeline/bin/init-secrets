#!/usr/bin/env bash
# Create ./secrets with the files this testbed generates itself; never overwrites.
# The two real credentials are copied in by hand (README, Secrets).
set -euo pipefail
cd "$(dirname "$0")/.."
umask 077
mkdir -p secrets/sam-idms-ldap
gen() { [[ -s $1 ]] || { openssl rand -base64 24 >"$1"; echo "generated $1"; }; }
# The local slapd's own passwords; they guard nothing but this replica.
for f in admin_password config_password readonly_user_password; do
    gen "secrets/sam-idms-ldap/$f"
done
# bin/syncd requires the file to exist; LDAPSTAGING_URL is a .invalid host, so it is never sent.
gen secrets/LDAPSTAGING_AUTH_citldapsam
# The sam-idms-ldap entrypoint requires LDAP_AUTH_<authcid>; anonymous mode never sends it.
[[ -s secrets/LDAP_AUTH_anonymous ]] || { printf unused >secrets/LDAP_AUTH_anonymous; echo "generated secrets/LDAP_AUTH_anonymous"; }
chmod -R go-rwx secrets
for f in LDAP_AUTH_citldapsam sam.parm; do
    [[ -s secrets/$f ]] && echo "present   secrets/$f" || echo "MISSING   secrets/$f  (copy from sam-app; see README)"
done
