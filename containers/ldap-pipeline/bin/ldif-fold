#!/usr/bin/env python3
"""Apply a slapd audit log to a slapcat dump; write the result as slapadd-ready LDIF.

Usage: bin/ldif-fold DUMP AUDITLOG OUT. The result is the directory as of the last
audit record, operational attributes (entryCSN, modifyTimestamp) included, parents
before children. Feed both through bin/ldif-scrub first.
"""
import os
import sys
from collections import Counter

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from ldiflib import Entry, norm, records, split  # noqa: E402


def read(path):
    with open(path, encoding="utf-8", errors="surrogateescape") as f:
        yield from records(f)


def load_dump(path):
    entries = {}
    for rec in read(path):
        e = Entry.parse(rec)
        entries[norm(e.dn)] = e
    return entries


def apply(entries, rec, stats):
    dn = split(rec[0])[1].decode("utf-8", "surrogateescape")
    key = norm(dn)
    ctype = split(rec[1])[1].decode().lower() if len(rec) > 1 else "modify"
    body = rec[2:]
    if ctype == "add":
        if key in entries:
            stats["add over existing"] += 1
        e = Entry(dn)
        for line in body:
            e.add(*split(line))
        entries[key] = e
    elif ctype == "delete":
        if entries.pop(key, None) is None:
            stats["delete of missing"] += 1
    elif ctype in ("modrdn", "moddn"):
        e = entries.pop(key, None)
        if e is None:
            stats["rename of missing"] += 1
            return
        opts = {k.lower(): v.decode() for k, v in map(split, body)}
        parent = opts.get("newsuperior") or dn.split(",", 1)[1]
        if opts.get("deleteoldrdn") == "1":
            a, v = dn.split(",", 1)[0].split("=", 1)
            e.delete(a, [v.encode()])
        a, v = opts["newrdn"].split("=", 1)
        e.add(a, v.encode())
        e.dn = f"{opts['newrdn']},{parent}"
        entries[norm(e.dn)] = e
    else:
        e = entries.get(key)
        if e is None:
            stats["modify of missing"] += 1
            return
        i = 0
        while i < len(body):
            op, attr = (s.strip() for s in body[i].split(":", 1))
            values = []
            i += 1
            while i < len(body) and body[i] != "-":
                values.append(split(body[i])[1])
                i += 1
            i += 1
            if op == "add":
                for v in values:
                    e.add(attr, v)
            elif op == "delete":
                e.delete(attr, values)
            elif op == "replace":
                e.delete(attr)
                for v in values:
                    e.add(attr, v)
    stats[ctype] += 1


def main(dump, audit, out):
    entries = load_dump(dump)
    stats = Counter()
    for rec in read(audit):
        apply(entries, rec, stats)
    ordered = sorted(entries.values(), key=lambda e: norm(e.dn).count(","))
    with open(out, "w", encoding="utf-8", errors="surrogateescape") as o:
        for e in ordered:
            o.write("\n".join(e.lines()) + "\n\n")
    print(f"{len(entries)} entries; applied {dict(stats)}", file=sys.stderr)


if __name__ == "__main__":
    if len(sys.argv) != 4:
        sys.exit(__doc__)
    main(*sys.argv[1:])
