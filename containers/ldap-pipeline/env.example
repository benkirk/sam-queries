## Copy to .env. Read by docker compose AND passed whole into every container (env_file),
## as on sam-app. Values match sam-ldap-syncd/prod/.env there except where marked LOCAL.

# Container variables defined in SWEET Dockerfile ENV commands.
SECRETS_VOL=/run/secrets
SECRETS_DIR=/tmp/private/secrets
CONFIG_VOL=/run/etc
CONFIG_DIR=/tmp/etc
DATA_VOL=/var/data
DATA_DIR=/var/data

CONSTANTS=/usr/local/sam-ldap-syncd/lib/Constants.rc
SYNCD_DIR=/var/data/syncd

# Users and groups
SWEETUSER=sweetuser
SWEETUSERID=900
SWEETGROUP=sweetuser
SWEETGROUPID=900
SAMUSER=tomcat-sam
SAMUSERID=303
SAMGROUP=tomcat-sam
SAMGROUPID=303

#
# sam-idms-ldap
#
# LOCAL: RIDs dev=165 test=166 prod=167 are taken on sam-app.
SYNCREPL_CONSUMER_RID=168
SYNCREPL_PROVIDER_URL=ldaps://fdb.ucar.edu
SYNCREPL_PROVIDER_PUBLIC_REPLICA_URL=ldap://public-ldap.cloud.ucar.edu
SYNCREPL_PROVIDER_AUTHCID=citldapsam
LDAP_TLS_VERIFY_CLIENT=never
LDAP_LOG_LEVEL=256

#
# sam-idms-ldap and sam-ldap-transformer
#
AUDITLOG_DIR=/var/data/auditlog.d
MAIN_DBNUM=1

#
# sam-ldap-transformer
#
PROCESSING_LOOP_SLEEP_SECS=60

#
# sam-ldap-transformer and sam-ldap-syncd
#
SYNCD_RESET_FILE=/var/data/.reset

#
# sam-ldap-syncd
#
# LOCAL: prod reads need SAM_READ_PROD=1 (test-sam answers 404 everywhere, 2026-10-08).
# Our webapp is http://host.docker.internal:5050, the only target that may take writes.
SAM_URL=https://sam.ucar.edu:443
SAM_READ_PROD=
HTTPS_CA_DIR=/etc/ssl/certs
SAM_USER=admin
SAM_HTTP_LOG_LEVEL_MAX=4
# LOCAL: writes to SAM go to this file under SYNCD_DIR. The guard refuses an empty
# value unless SAM_URL is our own webapp.
SAM_UPDATES_STUB=sam-update-stub.log
SYNCD_SAMUPDATE_DEBUG_LOG=samupdate-dbg.log
# LOCAL: prod is ldaps://fdbstage.ucar.edu, which is reachable from a laptop. The guard
# requires a .invalid host here and a non-empty stub file, always.
LDAPSTAGING_URL=ldaps://fdbstage.invalid
LDAPSTAGING_USER=citldapsam
LDAPSTAGING_UPDATES_STUB=ldap-update-stub.log
#SYNCD_LIFECYCLE_CRON_DFLT="0 22 * * * *"
#SYNCD_PROJECTS_CRON_DFLT="0 4,6,8,10,12,14,16,18 * * * *"
# disable cron jobs temporarily
# NOTE: inert, as in prod: bin/syncd reads SYNCD_*_CRON, not *_DFLT (NCAR/sam-ldap-syncd#6).
SYNCD_LIFECYCLE_CRON_DFLT="0 22 * 12 * *"
SYNCD_PROJECTS_CRON_DFLT="0 4,6,8,10,12,14,16,18 * 12 * *"

#
# Harness only (not read by the images). The pair bin/build-images builds and compose runs.
# Native on Apple silicon: PIPELINE_TAG=pipeline-arm64, PIPELINE_PLATFORM=linux/arm64.
#
PIPELINE_TAG=pipeline-local
PIPELINE_PLATFORM=linux/amd64
# Hybrid stage 1 (fdb refuses citldapsam off sam-app): seeded from prod's dump, then
# polled anonymously from ldap.ucar.edu. See README, Choosing the LDAP source.
COMPOSE_FILE=compose.yaml:compose.hybrid.yaml
