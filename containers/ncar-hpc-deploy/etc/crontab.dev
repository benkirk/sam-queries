# ncar-hpc-deploy, dev lane — writes sam_dev and posts to samuel-dev; tracks :staging.
# No jobhist-sync (etc/schedule lists it prod-only): the job_history DBs are shared with prod.
# Locking as in crontab.prod: cron-side flock per line, waits under the interval, then mails.
NHD=/glade/u/apps/opt/sam-queries/containers/ncar-hpc-deploy/bin/ncar-hpc-deploy
SSH="ssh -o BatchMode=yes -o LogLevel=error -o ServerAliveInterval=60 -o ServerAliveCountMax=5"
L=/tmp/csgteam-nhd-dev

# Off the */5 grid, as in crontab.prod.
47 * * * *      flock -E 75 -xw 3000 $L-update.lock $SSH casper.hpc.ucar.edu "$NHD update --lane dev --smoke-hosts derecho.hpc.ucar.edu"; [ $? -ne 75 ] || echo "nhd dev update: previous still running after 50m" >&2

*/5 * * * *     flock -E 75 -xw 240  $L-rapid-casper.lock   $SSH casper.hpc.ucar.edu  "$NHD tick --lane dev rapid  >/dev/null"; [ $? -ne 75 ] || echo "nhd dev rapid casper: previous still running after 4m" >&2
*/5 * * * *     flock -E 75 -xw 240  $L-rapid-derecho.lock  $SSH derecho.hpc.ucar.edu "$NHD tick --lane dev rapid  >/dev/null"; [ $? -ne 75 ] || echo "nhd dev rapid derecho: previous still running after 4m" >&2
19 * * * *      flock -E 75 -xw 3000 $L-hourly-casper.lock  $SSH casper.hpc.ucar.edu  "$NHD tick --lane dev hourly >/dev/null"; [ $? -ne 75 ] || echo "nhd dev hourly casper: previous still running after 50m" >&2
24 * * * *      flock -E 75 -xw 3000 $L-hourly-derecho.lock $SSH derecho.hpc.ucar.edu "$NHD tick --lane dev hourly >/dev/null"; [ $? -ne 75 ] || echo "nhd dev hourly derecho: previous still running after 50m" >&2
09 01 * * *     flock -E 75 -xn $L-daily-casper.lock   $SSH casper.hpc.ucar.edu  "$NHD tick --lane dev daily  >/dev/null"; [ $? -ne 75 ] || echo "nhd dev daily casper: previous still running" >&2
14 01 * * *     flock -E 75 -xn $L-daily-derecho.lock  $SSH derecho.hpc.ucar.edu "$NHD tick --lane dev daily  >/dev/null"; [ $? -ne 75 ] || echo "nhd dev daily derecho: previous still running" >&2
