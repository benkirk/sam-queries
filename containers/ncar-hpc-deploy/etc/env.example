# lanes/<lane>/env: the public layer, 0644, read by every tool and job (README.md § Lanes).
# Read-only roles only: any HPC user can read this file. apptainer --env-file syntax: set final
# names (no ${VAR} aliases across layers), and write a literal $ as \$, even inside quotes.
# SAM database (prod: MySQL sam-sql; dev: Postgres sam_dev on csg-postgres)
SAM_DB_DRIVER=              # dev: postgresql; unset = mysql
SAM_DB_SERVER=
SAM_DB_NAME=                # dev: sam_dev
SAM_DB_USERNAME=hpc-reader
SAM_DB_PASSWORD=
SAM_DB_REQUIRE_SSL=true
SAM_DB_READ_ONLY=1
# job_history (hpc-usage-queries), read through the standby (OpenBao csg/hpc-reader-pg)
JOB_HISTORY_DB_BACKEND=postgres
JOB_HISTORY_PG_HOST=csg-postgres-ro.k8s.ucar.edu
JOB_HISTORY_PG_PORT=5432
JOB_HISTORY_PG_REQUIRE_SSL=true
JOB_HISTORY_PG_USER=hpc_reader
JOB_HISTORY_PG_PASSWORD=
# system_status (user last-seen)
STATUS_DB_DRIVER=postgresql
STATUS_DB_SERVER=csg-postgres-ro.k8s.ucar.edu
STATUS_DB_NAME=system_status
STATUS_DB_USERNAME=hpc_reader
STATUS_DB_PASSWORD=
STATUS_DB_REQUIRE_SSL=true
STATUS_DB_READ_ONLY=1
# libpq: SCRAM channel binding ties the login to the TLS session (no CA file needed)
PGCHANNELBINDING=require
