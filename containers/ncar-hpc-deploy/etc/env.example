# lanes/<lane>/env — sourced by apptainer --env-file (0600, owner only).
# Shell syntax; ${VAR} references to earlier lines resolve.
# SAM database (prod: MySQL sam-sql; dev: Postgres sam_dev on csg-postgres)
SAM_DB_DRIVER=              # dev: postgresql; unset = mysql
SAM_DB_SERVER=
SAM_DB_NAME=                # dev: sam_dev
SAM_DB_USERNAME=
SAM_DB_PASSWORD=
SAM_DB_REQUIRE_SSL=
# job_history (hpc-usage-queries) — READ role (pguser) here; the DML writer goes in env.jobhist-sync
CIRRUS_PG_HOST=
CIRRUS_PG_USER=
CIRRUS_PG_PASSWORD=
JOB_HISTORY_DB_BACKEND=postgres
JOB_HISTORY_PG_HOST=${CIRRUS_PG_HOST}
JOB_HISTORY_PG_USER=${CIRRUS_PG_USER}
JOB_HISTORY_PG_PASSWORD=${CIRRUS_PG_PASSWORD}
JOB_HISTORY_PG_PORT=5432
JOB_HISTORY_PG_REQUIRE_SSL=
# status collectors (prod: https://samuel.k8s.ucar.edu; dev: https://samuel-dev.k8s.ucar.edu)
STATUS_API_URL=
STATUS_API_USER=collector
STATUS_API_KEY=
JUPYTERHUB_API_URL=https://jupyterhub.hpc.ucar.edu
JUPYTERHUB_INSTANCE=
JUPYTERHUB_API_TOKEN=
